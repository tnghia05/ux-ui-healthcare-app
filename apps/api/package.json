  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/mongoose": "12.0.0",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.0.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "mongoose": "9.11.4",
    "nodemailer": "^10.2.1",
    "qrcode": "1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.3.2",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "1.5.6",
    "typescript": "6.0.3"
