PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27018/uxui?replicaSet=rs0&directConnection=true
CORS_ORIGINS=http://localhost:8081

# Local email inbox only. Production requires an SMTP provider.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=UX_UI <noreply@uxui.local>
# Generate a private random secret of at least 32 characters in .env.
OTP_SECRET=
# Local registration test only; ignored when NODE_ENV=production.
REGISTRATION_DEMO_OTP=

# Local check-in test only: one booking, until the normal window opens. Ignored in production.
CHECKIN_TEST_BOOKING_ID=
CHECKIN_TEST_UNTIL=

# Server-only AI configuration. Never add this key to mobile EXPO_PUBLIC variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Compatible OSRM endpoint; default community server is for light coursework use.
OSRM_BASE_URL=https://routing.openstreetmap.de/routed-car
