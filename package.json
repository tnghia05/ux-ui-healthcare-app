{
  "name": "ux-ui-healthcare",
  "private": true,
  "packageManager": "pnpm@12.4.0",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:api": "pnpm --filter @uxui/api dev",
    "dev:mobile": "pnpm --filter @uxui/mobile dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint apps --max-warnings 0",
    "test": "pnpm --filter @uxui/api test",
    "db:up": "docker compose -f infra/compose.yaml up -d --wait",
    "db:down": "docker compose -f infra/compose.yaml down"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.1",
    "eslint": "^9.39.0",
    "globals": "^16.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.46.0"
  }
}
